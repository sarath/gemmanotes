{
  "name": "gemmanotes",
  "version": "0.1.9",
  "description": "Push-to-talk voice notes for Obsidian, transcribed on-device with Gemma 4.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint src",
    "build": "npm run lint && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "local:deploy": "node scripts/deploy_and_reload.js",
    "local:test-load": "node scripts/test_model_load.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "voice",
    "transcription",
    "gemma"
  ],
  "author": "Sarath Chandra",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.19.21",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}

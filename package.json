{
  "name": "gemmanotes",
  "version": "0.1.3",
  "description": "Push-to-talk voice notes for Obsidian, transcribed on-device with Gemma 4.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "local:deploy": "node scripts/deploy_and_reload.js",
    "local:test-load": "node scripts/test_model_load.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "voice",
    "transcription",
    "gemma"
  ],
  "author": "Sarath Chandra",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
